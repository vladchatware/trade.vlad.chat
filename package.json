{
  "name": "mahoraga",
  "private": true,
  "version": "1.0.0",
  "description": "Autonomous LLM-powered trading agent - Next.js + Convex + Vercel AI Gateway",
  "workspaces": ["packages/*"],
  "packageManager": "bun@1.1.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "convex:dev": "bun --cwd packages/convex convex dev",
    "convex:deploy": "bun --cwd packages/convex convex deploy",
    "dashboard:dev": "bun --cwd packages/dashboard dev",
    "dashboard:build": "bun --cwd packages/dashboard build",
    "dashboard:start": "bun --cwd packages/dashboard start"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "lefthook": "^1.10.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.1.0"
  }
}
