{
  "name": "mahoraga",
  "private": true,
  "version": "1.0.0",
  "description": "Autonomous LLM-powered trading agent - Next.js + Convex + Vercel AI Gateway",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"bun run convex:dev\" \"bun run next:dev\"",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "next:dev": "next dev"
  },
  "dependencies": {
    "convex": "^1.17.0",
    "framer-motion": "^12.0.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "clsx": "^2.1.1",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@commitlint/cli": "^20.4.0",
    "@commitlint/config-conventional": "^20.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.0.0",
    "lefthook": "^1.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.1.0"
  }
}
