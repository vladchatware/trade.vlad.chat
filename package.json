{
  "name": "mahoraga",
  "private": true,
  "version": "1.0.0",
  "description": "Autonomous LLM-powered trading agent - Next.js + Convex + Vercel AI Gateway",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"bun run convex:dev\" \"bun run next:dev\" \"bun run worker:dev\"",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "commitlint": "commitlint --edit",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "next:dev": "next dev",
    "worker:dev": "bun run worker/index.ts",
    "worker:watch": "bun run --watch worker/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.3",
    "clsx": "^2.1.1",
    "convex": "^1.17.0",
    "framer-motion": "^12.29.3",
    "mcp-handler": "^1.0.7",
    "next": "15.5.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@commitlint/cli": "^20.4.0",
    "@commitlint/config-conventional": "^20.4.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^25.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.0.0",
    "dotenv": "^17.2.3",
    "jsdom": "^28.0.0",
    "lefthook": "^1.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.1.0"
  }
}
